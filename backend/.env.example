# POVO AI Guidance API. Copy to .env (or .env.local for per-machine overrides).
# Only this file is committed. Real values live in .env / .env.local or in the
# Posit Connect "Vars" panel. Process environment variables win over both files.
# Keep comments on their own lines: "KEY=  # text" would read "# text" as the value.

# --- App ---------------------------------------------------------------------
# development | production | testing
ENVIRONMENT=development
DEBUG=false
APP_NAME=POVO AI Guidance
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5175
APP_TIMEZONE=America/New_York
# Used only when ENVIRONMENT != production and the identity header is absent.
DEV_FALLBACK_USERNAME=vturano
POSIT_IDENTITY_HEADER=RStudio-Connect-Credentials
# YYYY-MM-DD, development and tests only; refused in production.
POVO_TODAY_OVERRIDE=

# --- Data --------------------------------------------------------------------
# local (DuckDB file) | databricks
DATA_SOURCE=local
# Defaults: backend/.localdata/povo.duckdb and databricks/seed/output
# LOCAL_DUCKDB_PATH=
# SEED_OUTPUT_DIR=
BRONZE_CACHE_SECONDS=600

DATABRICKS_HOST=
DATABRICKS_TOKEN=
# The warehouse id, or its http path /sql/1.0/warehouses/<id>
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=povo_ai_guidance
DATABRICKS_SCHEMA=bronze
DATABRICKS_APP_SCHEMA=app

# --- AI and n8n ----------------------------------------------------------------
AI_ENABLED=true
N8N_BASE_URL=http://localhost:5680
N8N_CALL_PREP_PATH=/webhook/povo-call-prep
N8N_COMPLIANCE_PATH=/webhook/povo-compliance-check
N8N_NEXT_CALL_PATH=/webhook/povo-next-call
N8N_TIMEOUT_SECONDS=60
AI_CACHE_HOURS=24
# Required in production; shared with the n8n nightly workflow.
POVO_SERVICE_TOKEN=
