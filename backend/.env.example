# POVO AI Guidance API. Copy to .env (or .env.local for per-machine overrides).
# Only this file is committed. Real values live in .env / .env.local or in the
# Posit Connect "Vars" panel. Process environment variables win over both files.
# Keep comments on their own lines: "KEY=  # text" would read "# text" as the value.

# --- App ---------------------------------------------------------------------
# development | production | testing
ENVIRONMENT=development
DEBUG=false
APP_NAME=POVO AI Guidance
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5175
APP_TIMEZONE=America/New_York
# Used only when ENVIRONMENT != production and the identity header is absent.
DEV_FALLBACK_USERNAME=vturano
POSIT_IDENTITY_HEADER=RStudio-Connect-Credentials
# Where signed-in users are checked:
#   app     = the seed DIM_EMPLOYEE / DIM_SALES_ASSIGNMENT (development)
#   trinity = bis_prod.bronze_trinity DIM_EMPLOYEE (active EMP_USER_ID) and
#             DIM_SALES_FORCE_CURR (territory), over the DATABRICKS_* connection.
#             Required in production.
IDENTITY_SOURCE=app
TRINITY_CATALOG=bis_prod
TRINITY_SCHEMA=bronze_trinity
# Sales-force teams per brand, TEAM_NAME or TEAM_ID: POVO:TEAM A|TEAM B,OPZ:21
# Empty = every team sells DEFAULT_BRAND_CODE.
TRINITY_BRAND_TEAMS=POVO:POVO
IDENTITY_CACHE_SECONDS=60
# IDENTITY_SOURCE=trinity on local/sqlite data: the seed territory shown to a
# Trinity user the seed does not know (e.g. NE-POR). Blank = their own (no data).
LOCAL_DATA_TERRITORY_ID=
# YYYY-MM-DD, development and tests only; refused in production.
POVO_TODAY_OVERRIDE=
# Brand used when a request names none; registered at start with every feature on.
DEFAULT_BRAND_CODE=POVO
# JSON {"admins": ["username", ...]}: who may configure brands and features
# and impersonate other users.
# Empty = backend/config/admin_users.json.
# ADMIN_USERS_FILE=

# --- Data --------------------------------------------------------------------
# local = DuckDB (bronze reloaded from the seed CSVs at every start)
# sqlite = one SQLite file that keeps all data (interim, until Databricks)
# databricks = the SQL warehouse (the VM)
# none = sign-in only (Posit dev): empty in-memory tables, nothing on disk;
#        with IDENTITY_SOURCE=trinity the user and territory are real
# demo = the POC dummy data (the seed CSVs) loaded into memory, nothing on disk;
#        every signed-in user sees a seed territory (LOCAL_DATA_TERRITORY_ID,
#        blank = vturano's NE-POR). Changes are lost at restart.
DATA_SOURCE=sqlite
# Defaults: backend/.localdata/povo.duckdb, backend/.localdata/povo.sqlite and databricks/seed/output
# LOCAL_DUCKDB_PATH=
# SQLITE_PATH=
# SEED_OUTPUT_DIR=
BRONZE_CACHE_SECONDS=600

DATABRICKS_HOST=
DATABRICKS_TOKEN=
# The warehouse id, or its http path /sql/1.0/warehouses/<id>
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=povo_ai_guidance
DATABRICKS_SCHEMA=bronze
DATABRICKS_APP_SCHEMA=app

# --- AI and n8n ----------------------------------------------------------------
AI_ENABLED=true
N8N_BASE_URL=http://localhost:5680
N8N_CALL_PREP_PATH=/webhook/povo-call-prep
N8N_COMPLIANCE_PATH=/webhook/povo-compliance-check
N8N_NEXT_CALL_PATH=/webhook/povo-next-call
N8N_EXAMPLE_NOTES_PATH=/webhook/povo-example-notes
N8N_TIMEOUT_SECONDS=60
AI_CACHE_HOURS=24
# Required in production; shared with the n8n nightly workflow.
POVO_SERVICE_TOKEN=
