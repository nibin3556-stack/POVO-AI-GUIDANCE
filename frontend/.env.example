# Base URL of the POVO AI Guidance API.
# Development: leave empty so requests stay same-origin and go through the
# Vite proxy (vite.config.ts -> http://127.0.0.1:8030).
# Production (Posit Connect): the backend content URL, e.g.
#   VITE_API_URL=https://posit.example.com/content/<backend-guid>
VITE_API_URL=

# Development only: the username the Vite proxy injects as the Posit identity
# header (RStudio-Connect-Credentials). Must exist in DIM_EMPLOYEE.
VITE_DEV_USER=vturano
