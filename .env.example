# docker-compose.yml (local n8n only). Copy to .env and fill in; never commit .env.
# The backend's own settings live in backend/.env (see backend/.env.example).

# Where n8n's nightly job reaches the FastAPI backend (from inside the container).
POVO_BACKEND_URL=http://host.docker.internal:8030

# Shared secret sent as X-POVO-Service-Token to /api/v1/jobs/*.
# Must equal POVO_SERVICE_TOKEN in backend/.env.
POVO_SERVICE_TOKEN=change-me-to-a-long-random-string
